{
    "compilerOptions": {
        "outDir": "./wwwroot/js",
        "sourceMap": true,
        "noImplicitAny": true,
        "module": "commonjs",
        "target": "es2018",
        "jsx": "react",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "lib": ["es2018", "dom"]
    },
    "include": [
        "./Scripts/**/*"
    ],
    "exclude": [
        "**/node_modules/**",
        "**/testcafe/**"
    ],
    "typeRoots": [
        "./node_modules/@types"
    ],
    "types": [
        "react",
        "react-dom",
        "react-redux",
        "react-router-dom",
        "query-string",
        "jest",
        "mongoose"
    ]
}

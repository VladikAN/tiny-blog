{
  "name": "tinyblog",
  "version": "1.0.0",
  "description": "Simple blog engine",
  "main": "index.js",
  "scripts": {
    "dev": "webpack --color --progress",
    "dev:watch": "npm run dev -- --watch",
    "release": "npm run lint && npm run test && webpack --config webpack.prod.config.js --progress",
    "lint": "eslint --ext ts,tsx Scripts/",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "testcafe": "testcafe"
  },
  "author": "https://github.com/vladikan/tiny-blog.git",
  "repository": "https://github.com/vladikan/tiny-blog.git",
  "license": "ISC",
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.24.2",
    "jwt-decode": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-localization": "^1.0.19",
    "react-redux": "^8.1.3",
    "react-router-dom": "^5.3.4",
    "react-showdown": "^1.6.0",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/jwt-decode": "^2.2.1",
    "@types/mongoose": "^5.11.97",
    "@types/query-string": "^6.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-redux": "^7.1.34",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "buffer": "^6.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.4",
    "file-loader": "^6.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.2",
    "mongoose": "^5.13.23",
    "redux-devtools-extension": "^2.13.9",
    "sass": "^1.84.0",
    "sass-loader": "^16.0.4",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.11",
    "testcafe": "^3.7.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.3",
    "webpack": "^5.97.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^6.0.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "transform": {
      "\\.(ts|tsx)$": "ts-jest"
    },
    "testRegex": "/__tests__/.*\\.(ts|tsx|js)$",
    "setupFilesAfterEnv": [
      "<rootDir>/Scripts/setupTests.ts"
    ],
    "moduleNameMapper": {
      "^Styles/(.*)$": "<rootDir>/Content/Styles/$1"
    }
  }
}
